# Line-ending policy for the agent-workflow surface (Mason, 2026-07-13).
#
# `scripts/check-agent-workflows.mjs` regenerates the Codex adapter files under
# `.agents/` from the `.claude/` sources and compares them byte-for-byte. The
# generator emits Unix (LF) line endings. On Windows checkouts, `core.autocrlf=true`
# was rewriting these files to CRLF, so the check reported them "stale" (identical
# text, different line endings) and blocked every commit. Pinning both the sources
# it reads and the targets it writes to LF makes the check deterministic on every
# platform. Keep the sources and targets on the SAME ending or the mirror check
# fails the other direction.
.agents/**          text eol=lf
.claude/skills/**   text eol=lf
.claude/commands/** text eol=lf
.husky/**           text eol=lf
.github/workflows/** text eol=lf
*.sh                 text eol=lf

# These migrations are already applied live and contain content-bound
# function-body hashes. Preserve each artifact's reviewed bytes in Git so a
# clean checkout replays the same pg_proc.prosrc bodies on every operating system.
supabase/migrations/20260717042803_supplier_pricing_phase1a.sql -text diff whitespace=cr-at-eol
supabase/migrations/20260717112011_supplier_pricing_zero_cost_guard.sql text eol=lf
supabase/migrations/20260717171331_restore_legacy_pricing_version_compat.sql text eol=lf
supabase/migrations/20260722222743_product_families_return_policy_foundation.sql text eol=lf
scripts/smoke/fixtures/phase3-live-unapply-credit-memo.sql text eol=lf

# Generated clean-rebuild baselines are hash-verified release artifacts.
supabase/baselines/*.sql  text eol=lf
supabase/baselines/*.json text eol=lf
# pg_dump preserves legacy CRLF inside pg_proc.prosrc while emitting LF around
# it. Treat that mixed-byte snapshot as an immutable artifact, not normal text.
supabase/baselines/*_public_schema.sql -text -diff whitespace=-trailing-space,cr-at-eol
supabase/baselines/*_public_schema.sql.br -text -diff
