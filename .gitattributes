# Line-ending policy for the agent-workflow surface (Mason, 2026-07-13).
#
# `scripts/check-agent-workflows.mjs` regenerates the Codex adapter files under
# `.agents/` from the `.claude/` sources and compares them byte-for-byte. The
# generator emits Unix (LF) line endings. On Windows checkouts, `core.autocrlf=true`
# was rewriting these files to CRLF, so the check reported them "stale" (identical
# text, different line endings) and blocked every commit. Pinning both the sources
# it reads and the targets it writes to LF makes the check deterministic on every
# platform. Keep the sources and targets on the SAME ending or the mirror check
# fails the other direction.
.agents/**          text eol=lf
.claude/skills/**   text eol=lf
.claude/commands/** text eol=lf
.husky/**           text eol=lf
.github/workflows/** text eol=lf
*.sh                 text eol=lf

# These migrations are already applied live and contain content-bound
# function-body hashes. Preserve each artifact's reviewed bytes in Git so a
# clean checkout replays the same pg_proc.prosrc bodies on every operating system.
supabase/migrations/20260717042803_supplier_pricing_phase1a.sql -text diff whitespace=cr-at-eol
supabase/migrations/20260717112011_supplier_pricing_zero_cost_guard.sql text eol=lf
supabase/migrations/20260717171331_restore_legacy_pricing_version_compat.sql text eol=lf
supabase/migrations/20260723193312_product_families_return_policy_foundation.sql text eol=lf
supabase/migrations/20260729222311_bind_save_field_actor.sql text eol=lf
scripts/smoke/fixtures/phase3-live-unapply-credit-memo.sql text eol=lf

# Wave A. Not yet applied, but the same rule applies for the same reason, and
# here it binds BEFORE the first apply rather than after: each of these pins an
# md5 of a function body this file itself installs, so the bytes Git hands the
# applier ARE the bytes hashed. Confirmed against live 2026-08-12 —
# public.complete_delivery stores LF and hashes to its pinned value, while
# _close_undelivered_order_remainder_20260718 stores CRLF, so prosrc really does
# inherit whatever the source file carried. Without these lines a Windows
# checkout under core.autocrlf=true would install CRLF bodies whose md5 can never
# match an LF-computed pin, and every one of these migrations would abort at its
# own POSTCOND on a machine that merely checked the repo out differently.
supabase/migrations/20260813010000_wave_a_order_cost_authority_and_finiteness.sql text eol=lf
supabase/migrations/20260813020000_round_order_header_money.sql text eol=lf
supabase/migrations/20260813030000_reject_non_finite_money_and_quantities.sql text eol=lf
supabase/migrations/20260813040000_clamp_negative_commission_remainder.sql text eol=lf
supabase/migrations/20260813050000_guard_job_commission_split_immutable.sql text eol=lf
supabase/migrations/20260813060000_require_completed_delivery_before_invoice_post.sql text eol=lf

# Generated clean-rebuild baselines are hash-verified release artifacts.
supabase/baselines/*.sql  text eol=lf
supabase/baselines/*.json text eol=lf
# pg_dump preserves legacy CRLF inside pg_proc.prosrc while emitting LF around
# it. Treat that mixed-byte snapshot as an immutable artifact, not normal text.
supabase/baselines/*_public_schema.sql -text -diff whitespace=-trailing-space,cr-at-eol
supabase/baselines/*_public_schema.sql.br -text -diff

# The manifest binds these two capture scripts by SHA-256 of their working-tree
# bytes, so that redefining "matches production" fails the gate. On a Windows
# checkout `core.autocrlf=true` rewrote them to CRLF and the hash could never
# match: `npm run test:schema-baseline` failed on a fresh clone while passing in
# Linux CI. Pin them to LF so the binding means the same thing on every platform.
scripts/schema-baseline-fingerprints.sql text eol=lf
scripts/schema-baseline-acl.sql text eol=lf
