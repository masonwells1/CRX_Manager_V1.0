# Line-ending policy for the agent-workflow surface (Mason, 2026-07-13).
#
# `scripts/check-agent-workflows.mjs` regenerates the Codex adapter files under
# `.agents/` from the `.claude/` sources and compares them byte-for-byte. The
# generator emits Unix (LF) line endings. On Windows checkouts, `core.autocrlf=true`
# was rewriting these files to CRLF, so the check reported them "stale" (identical
# text, different line endings) and blocked every commit. Pinning both the sources
# it reads and the targets it writes to LF makes the check deterministic on every
# platform. Keep the sources and targets on the SAME ending or the mirror check
# fails the other direction.
.agents/**          text eol=lf
.claude/skills/**   text eol=lf
.claude/commands/** text eol=lf
