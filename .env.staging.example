# Staging Environment Configuration
# IMPORTANT: Create a SEPARATE Supabase project for staging
# DO NOT use your production database for testing!

# Staging Supabase Configuration
# Get these from your STAGING Supabase project: https://supabase.com/dashboard/project/_/settings/api

# Your STAGING Supabase project URL
VITE_SUPABASE_URL=

# Your STAGING Supabase anonymous key
VITE_SUPABASE_ANON_KEY=

# Steps to set up staging:
# 1. Create a new Supabase project specifically for staging
# 2. Run all migrations in the staging project (they'll run automatically when you connect)
# 3. Copy the URL and anon key from the staging project API settings
# 4. Use these values when deploying to Netlify/Vercel staging environment
