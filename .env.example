# CRX Manager — Environment Variables
# Copy this file to `.env` (cp .env.example .env) and fill in the values below.
# This file is a TEMPLATE — it contains NO secrets and is safe to commit.
# Your real `.env` is gitignored and must never be committed.
#
# Only the VITE_SUPABASE_* values are required to run the app locally.
# Find Supabase values at: https://supabase.com/dashboard/project/_/settings/api

# --- Required ---

# Your Supabase project URL (e.g. https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase PUBLISHABLE anon key (safe to ship to the browser).
# NEVER put the service_role key here — it must stay server-side only.
VITE_SUPABASE_ANON_KEY=

# --- Optional ---

# Mapbox access token — enables the map / field-boundary features.
# Without it, map components render an error but the rest of the app works.
VITE_MAPBOX_TOKEN=

# Sentry DSN — enables error reporting. Leave blank to disable Sentry locally.
VITE_SENTRY_DSN=
