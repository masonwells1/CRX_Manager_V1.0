# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL (looks like: https://xxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Your Supabase anonymous key (this is safe to use in the browser)
VITE_SUPABASE_ANON_KEY=

# NOTE: All variables MUST start with VITE_ to be accessible in the React app
# After adding these values, copy this file to .env (not tracked by git)
