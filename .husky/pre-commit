#!/usr/bin/env sh

# --- SQL Migration Validation (prevents known anti-patterns) ---
echo "🛡️ Validating SQL migrations..."
bash scripts/validate-sql.sh
SQL_EXIT=$?

if [ $SQL_EXIT -ne 0 ]; then
  echo ""
  echo "❌ SQL VALIDATION FAILED — commit blocked. Fix SQL anti-patterns first."
  exit 1
fi

# --- Frontend Code Validation (prevents known anti-patterns) ---
echo "🛡️ Validating frontend code..."
bash scripts/validate-frontend.sh
FE_EXIT=$?

if [ $FE_EXIT -ne 0 ]; then
  echo ""
  echo "❌ FRONTEND VALIDATION FAILED — commit blocked. Fix anti-patterns first."
  exit 1
fi

echo "🔍 Running ESLint..."
npm run lint 2>&1
LINT_EXIT=$?

if [ $LINT_EXIT -ne 0 ]; then
  echo ""
  echo "❌ LINT FAILED — commit blocked. Fix lint errors first."
  exit 1
fi

echo ""
echo "🔎 Running TypeScript typecheck..."
npm run typecheck 2>&1
TYPECHECK_EXIT=$?

if [ $TYPECHECK_EXIT -ne 0 ]; then
  echo ""
  echo "❌ TYPECHECK FAILED — commit blocked. Fix type errors first."
  exit 1
fi

echo ""
echo "🔨 Running build check..."
npm run build 2>&1
BUILD_EXIT=$?

if [ $BUILD_EXIT -ne 0 ]; then
  echo ""
  echo "❌ BUILD FAILED — commit blocked. Fix build errors first."
  exit 1
fi

echo ""
echo "🧪 Running unit tests..."
npx vitest run 2>&1
TEST_EXIT=$?

if [ $TEST_EXIT -ne 0 ]; then
  echo ""
  echo "❌ TESTS FAILED — commit blocked. Fix failing tests first."
  exit 1
fi

echo ""
echo "📋 Checking doc drift (counts in CLAUDE.md / migration-history.md vs disk)..."
# husky runs this script under `sh -e`, so a bare failing command aborts the
# whole hook before any $? check — the || branch is what makes this step
# genuinely non-blocking (2026-06-11: five commit attempts died here silently).
node scripts/check-doc-drift.mjs || {
  echo ""
  echo "⚠️  DOC DRIFT DETECTED (non-blocking) — update migration-history.md / CLAUDE.md counts before next session."
}

echo ""
echo "🔗 Verifying dependency integrity (vitest/vite peer ranges)..."
# Same sh -e note as above: the || branch guarantees the friendly message
# prints before the (intentional) block.
node scripts/verify-deps.mjs || {
  echo ""
  echo "❌ DEPENDENCY PROBLEMS — commit blocked. Run \`npm ci\` or fix peer ranges first."
  exit 1
}

echo ""
echo "🗺  Regenerating workflow map..."
node scripts/generate-workflow-map.mjs
MAP_EXIT=$?

if [ $MAP_EXIT -ne 0 ]; then
  echo ""
  echo "⚠️  Workflow map generation failed — committing anyway (non-blocking)."
else
  # Stage the updated map so it's included in this commit automatically
  git add docs/app-workflow-map.html
fi

echo ""
echo "✅ Lint, build, tests, and map passed — committing."
