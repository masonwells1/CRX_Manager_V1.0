#!/usr/bin/env sh

# Keep commits fast and deterministic. This hook checks only staged, high-risk
# surfaces. Full lint, typecheck, unit/guard tests, coverage, and build remain
# durable PR gates in GitHub CI; typecheck and build also remain in pre-push.

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMRD)"

echo "📒 Checking ledger requirement..."
node scripts/check-ledger-update.mjs || {
  echo ""
  echo "❌ LEDGER MISSING — stage the real CHANGELOG/decision/reference update for this policy change."
  exit 1
}

# This is the one repository-wide local check retained at commit time. It must
# inspect untracked and modified paths too, not only staged files.
echo "🔒 Checking private-artifact containment..."
node scripts/check-supplier-pricing-phase3-private-artifacts.mjs --pre-commit || {
  echo ""
  echo "❌ PRIVATE ARTIFACT CONTAINMENT FAILED — move the artifact outside this repository."
  exit 1
}

if [ -z "$STAGED_FILES" ]; then
  echo "✅ No staged paths — containment passed; skipping staged-file checks."
  exit 0
fi

# Both validators already restrict themselves to staged files and exit quickly
# when their file type is absent.
echo "🛡️ Validating staged SQL migrations..."
bash scripts/validate-sql.sh || exit 1

echo "🛡️ Validating staged frontend files..."
bash scripts/validate-frontend.sh || exit 1

# Hook/settings changes can silently become one-sided between Claude and Codex.
# Run the focused manifest/sync check only when that control surface changed.
if printf '%s\n' "$STAGED_FILES" | grep -Eq '^((\.claude|\.codex)/(hooks|commands|skills|workflows|agents)/|\.claude/settings\.json$|\.codex/hooks\.json$|AGENTS\.md$|CLAUDE\.md$|scripts/(agent-manifest-parity|check-agent-workflows|sync-agent-workflows|normalize-eol)\.mjs$)'; then
  echo "🤝 Checking Claude/Codex workflow and hook parity..."
  node scripts/check-agent-workflows.mjs || {
    echo ""
    echo "❌ AGENT WORKFLOW PARITY FAILED — keep the effective Claude/Codex guard sets aligned."
    exit 1
  }
fi

# Dependency integrity is relevant only when the dependency contract changed.
if printf '%s\n' "$STAGED_FILES" | grep -Eq '^(package(-lock)?\.json|\.nvmrc)$'; then
  echo "🔗 Verifying dependency integrity..."
  node scripts/verify-deps.mjs || {
    echo ""
    echo "❌ DEPENDENCY PROBLEMS — run npm ci or fix peer ranges before committing."
    exit 1
  }
fi

echo ""
echo "✅ Fast staged-file safety checks passed. Full product proof runs at pre-push and in CI."
