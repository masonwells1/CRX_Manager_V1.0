#!/usr/bin/env sh
echo "🛡️ Pre-push safety check..."
echo ""
echo "Checking Phase 3C private-artifact containment..."
npm run check:phase3-private-artifacts 2>&1
CONTAINMENT_EXIT=$?

if [ $CONTAINMENT_EXIT -ne 0 ]; then
  echo ""
  echo "❌ PRIVATE ARTIFACT CONTAINMENT FAILED — push blocked."
  exit 1
fi

echo "Running TypeScript type check..."
npm run typecheck 2>&1
TC_EXIT=$?

if [ $TC_EXIT -ne 0 ]; then
  echo ""
  echo "❌ TYPE CHECK FAILED — push blocked."
  echo "Fix TypeScript errors before pushing to GitHub."
  exit 1
fi

echo ""
echo "Running build check..."
npm run build 2>&1
BUILD_EXIT=$?

if [ $BUILD_EXIT -ne 0 ]; then
  echo ""
  echo "❌ BUILD FAILED — push blocked."
  echo "Fix build errors before pushing to GitHub."
  exit 1
fi

echo ""
echo "🗺️ Refreshing local Graphify architecture map when code or database structure changed..."
node scripts/graphify-refresh.mjs --if-relevant
GRAPHIFY_EXIT=$?

if [ $GRAPHIFY_EXIT -ne 0 ]; then
  echo ""
  echo "⚠️ Graphify refresh skipped or failed — continuing because Graphify is an optional local navigation aid."
  echo "   Run npm run graph:refresh after installing Graphify to restore the local architecture map."
fi

echo ""
echo "✅ Type check and build passed — pushing to GitHub."
